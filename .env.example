# Database
# 5433 avoids clash with a local Windows PostgreSQL on 5432
POSTGRES_USER=minecraft
POSTGRES_PASSWORD=minecraft
POSTGRES_DB=minecraft_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://minecraft:minecraft@localhost:5433/minecraft_db?connection_limit=10&pool_timeout=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# API
API_PORT=4000
NODE_ENV=development
# Set true to log every Prisma SQL query (noisy, local debugging only)
PRISMA_DEBUG=false

# JWT
JWT_ACCESS_SECRET=change_me_dev_secret_access_min_64_chars_recommended_for_production_use_openssl_rand
JWT_REFRESH_SECRET=change_me_dev_secret_refresh_min_64_chars_recommended_for_production_use_openssl_rand
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# hCaptcha
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
HCAPTCHA_DISABLED=true

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Uploads
UPLOADS_DIR=./uploads
UPLOAD_MAX_AVATAR_SIZE=5242880
UPLOAD_MAX_BANNER_SIZE=10485760

# Frontend
# FRONTEND_URL нужен апи, чтобы собирать ссылки для писем (сброс пароля)
FRONTEND_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Email (optional — notifications digest / instant mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=TwoMC
SMTP_FROM_EMAIL=noreply@twomc.su

# Web Push (optional — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@twomc.su

# Seed
SEED_OWNER_EMAIL=owner@localhost
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=changeme123
