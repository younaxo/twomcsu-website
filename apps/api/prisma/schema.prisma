generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleGroup {
  PLAYER
  HELPER
  MODERATOR
  ADMIN
  OWNER
}

/// Title inside a role group: purely cosmetic, permissions come from roleGroup
model Position {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  displayName     String
  group           RoleGroup
  color           String    @db.VarChar(7)
  backgroundColor String?   @db.VarChar(9)
  icon            String?
  priority        Int       @default(0)
  description     String?
  isVisible       Boolean   @default(true)
  /// Given to new users of the group, one per group
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users    User[]
  products Product[]

  @@index([slug])
  @@index([group])
  @@index([priority])
  @@map("positions")
}

model User {
  id            String    @id @default(cuid())
  /// Public numeric id shown as #1, #2, ...
  shortId       Int       @unique @default(autoincrement())
  /// Public tag like youn#4a2b
  tag           String    @unique @db.VarChar(32)
  email         String    @unique
  username      String    @unique @db.VarChar(16)
  password      String
  roleGroup     RoleGroup @default(PLAYER)
  positionId    String
  avatar        String?
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Uploaded image, wins over bannerPreset when both are set
  banner        String?
  bannerPreset  String?
  statusText    String?   @db.VarChar(128)
  bio           String?   @db.VarChar(500)
  country       String?
  city          String?   @db.VarChar(100)
  gender        Gender?
  birthDate     DateTime?
  showBirthDate Boolean   @default(false)

  /// Who can open the public profile page
  profileVisibility   ProfileVisibility   @default(EVERYONE)
  /// Who is allowed to send friend requests
  friendRequestPolicy FriendRequestPolicy @default(EVERYONE)
  hideEmail           Boolean             @default(true)
  hideCountry         Boolean             @default(false)
  hideCity            Boolean             @default(false)
  hideBirthDate       Boolean             @default(true)
  hideGender          Boolean             @default(false)
  hideStatistics      Boolean             @default(false)
  hideSocials         Boolean             @default(false)

  /// Who can leave comments on this profile
  commentPolicy            CommentPolicy @default(EVERYONE)
  /// Forced off by staff; owner cannot re-enable while false
  commentsEnabled          Boolean       @default(true)
  commentsForcedDisabledBy String?
  commentsForcedReason     String?
  notifyOnComment          Boolean       @default(true)
  notifyOnMention          Boolean       @default(true)
  notifyOnReply            Boolean       @default(true)
  notifyOnFriendRequest    Boolean       @default(true)
  notifyOnGift             Boolean       @default(true)
  notifyOnOrder            Boolean       @default(true)

  position               Position             @relation(fields: [positionId], references: [id])
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  promoCodeUsages        PromoCodeUsage[]
  badges                 UserBadge[]
  socialLinks            SocialLink[]
  mediaBadges            UserMediaBadge[]
  mediaBadgeRequests     MediaBadgeRequest[]
  statistics             PlayerStatistics?
  awards                 UserAward[]
  profileViews           ProfileView[]        @relation("ProfileViewsReceived")
  viewedProfiles         ProfileView[]        @relation("ProfileViewsSent")
  profileReactions       ProfileReaction[]    @relation("ProfileReactionsReceived")
  givenReactions         ProfileReaction[]    @relation("ProfileReactionsSent")
  profileReports         ProfileReport[]      @relation("ProfileReportsReceived")
  sentReports            ProfileReport[]      @relation("ProfileReportsSent")
  sentFriendRequests     Friendship[]         @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]         @relation("FriendshipAddressee")
  profileComments        ProfileComment[]     @relation("ProfileComments")
  authoredComments       ProfileComment[]     @relation("AuthoredComments")
  notifications          Notification[]       @relation("NotificationsReceived")
  sentNotifications      Notification[]       @relation("NotificationsFrom")

  /// Referral code shown to friends; generated on registration
  referralCode String? @unique
  /// User id of whoever invited this account
  referredBy   String?

  /// Slug of the game server where the player was last seen
  currentServer      String?
  currentServerId    String?
  lastServerActivity DateTime?
  isOnlineInGame     Boolean   @default(false)

  cart        Cart?
  wishlist    Wishlist?
  orders      Order[]
  giftedItems OrderItem[] @relation("GiftedItems")

  @@index([email])
  @@index([username])
  @@index([tag])
  @@index([shortId])
  @@index([positionId])
  @@index([roleGroup, isBanned])
  @@index([lastLoginAt])
  @@index([currentServerId])
  @@index([isOnlineInGame])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// Single use link from the "forgot password" flow, lives an hour
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ProfileVisibility {
  EVERYONE
  FRIENDS_ONLY
  NOBODY
}

enum FriendRequestPolicy {
  EVERYONE
  FRIENDS_OF_FRIENDS
  NOBODY
}

enum CommentPolicy {
  EVERYONE
  FRIENDS
  FRIENDS_OF_FRIENDS
  NOBODY
}

enum CommentReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  IMPERSONATION
  OTHER
}

enum CommentReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum SocialPlatform {
  DISCORD
  TELEGRAM
  VK
  YOUTUBE
  TWITCH
  TIKTOK
  STEAM
}

/// Platforms a creator can be verified on, a subset of SocialPlatform
enum MediaGroup {
  YOUTUBE
  TWITCH
  TIKTOK
}

enum UserBadgeType {
  VERIFIED
  SUBSCRIBER_PLUS
  PROJECT_TEAM
  DEVELOPERS_TEAM
}

enum MediaBadgeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  IMPERSONATION
  OTHER
}

enum ProfileReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum DiscountType {
  PERCENT
  FIXED
  BONUS
}

model PromoCode {
  id                String        @id @default(cuid())
  code              String        @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(10, 2)
  /// null means unlimited
  maxUses           Int?
  usedCount         Int           @default(0)
  validFrom         DateTime?
  validUntil        DateTime?
  isActive          Boolean       @default(true)
  /// Empty = applies to every product type
  applicableToTypes ProductType[]
  minOrderAmount    Decimal?      @db.Decimal(10, 2)
  firstPurchaseOnly Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  usages PromoCodeUsage[]
  orders Order[]
  carts  Cart[]

  @@index([code])
  @@index([isActive])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  usedAt      DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_code_usages")
}

/// Staff granted marks shown next to the nickname
model UserBadge {
  id        String        @id @default(cuid())
  userId    String
  type      UserBadgeType
  grantedBy String?
  grantedAt DateTime      @default(now())
  expiresAt DateTime?
  isActive  Boolean       @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("user_badges")
}

/// One handle or url per platform, the platform decides how it is rendered
model SocialLink {
  id        String         @id @default(cuid())
  userId    String
  platform  SocialPlatform
  value     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@map("social_links")
}

/// Creator badge, appears on the profile once the staff approves the channel
model UserMediaBadge {
  id         String     @id @default(cuid())
  userId     String
  mediaGroup MediaGroup
  channelUrl String
  isApproved Boolean    @default(false)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaGroup])
  @@index([userId])
  @@map("user_media_badges")
}

model MediaBadgeRequest {
  id          String                  @id @default(cuid())
  userId      String
  mediaGroup  MediaGroup
  channelUrl  String
  description String?
  status      MediaBadgeRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("media_badge_requests")
}

/// Ready made banners a player can pick instead of uploading their own
model BannerPreset {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("banner_presets")
}

/// One row per viewer, so the counter shows unique visitors instead of refreshes
model ProfileView {
  id        String   @id @default(cuid())
  profileId String
  viewerId  String
  viewedAt  DateTime @default(now())

  profile User @relation("ProfileViewsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  viewer  User @relation("ProfileViewsSent", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([profileId, viewerId])
  @@index([profileId])
  @@index([profileId, viewedAt])
  @@map("profile_views")
}

model ProfileReaction {
  id        String       @id @default(cuid())
  profileId String
  userId    String
  type      ReactionType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  profile User @relation("ProfileReactionsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  user    User @relation("ProfileReactionsSent", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([profileId, userId])
  @@index([profileId])
  @@map("profile_reactions")
}

model ProfileReport {
  id          String              @id @default(cuid())
  profileId   String
  reporterId  String
  reason      ProfileReportReason
  description String?
  status      ProfileReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime            @default(now())

  profile  User @relation("ProfileReportsReceived", fields: [profileId], references: [id], onDelete: Cascade)
  reporter User @relation("ProfileReportsSent", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([profileId, reporterId])
  @@index([profileId])
  @@index([status])
  @@map("profile_reports")
}

/// Game side counters, the server pushes them here
model PlayerStatistics {
  id             String   @id @default(cuid())
  userId         String   @unique
  coins          Int      @default(0)
  /// Minutes spent in game
  playTime       Int      @default(0)
  kills          Int      @default(0)
  deaths         Int      @default(0)
  hits           Int      @default(0)
  killDeathRatio Float    @default(0)
  lastServer     String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_statistics")
}

model Award {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// External url or a path inside the web public folder
  iconUrl     String
  color       String?
  /// common, rare, epic or legendary, drives the border in the ui
  rarity      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userAwards UserAward[]

  @@map("awards")
}

model UserAward {
  id        String   @id @default(cuid())
  userId    String
  awardId   String
  grantedBy String?
  grantedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  award Award @relation(fields: [awardId], references: [id], onDelete: Cascade)

  @@unique([userId, awardId])
  @@index([userId])
  @@map("user_awards")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
  REJECTED
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friendships")
}

model ProfileComment {
  id            String           @id @default(cuid())
  profileId     String
  profile       User             @relation("ProfileComments", fields: [profileId], references: [id], onDelete: Cascade)
  authorId      String
  author        User             @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  contentHtml   String
  parentId      String?
  parent        ProfileComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ProfileComment[] @relation("CommentReplies")
  isPinned      Boolean          @default(false)
  pinnedAt      DateTime?
  pinnedBy      String?
  isEdited      Boolean          @default(false)
  editedAt      DateTime?
  isDeleted     Boolean          @default(false)
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?
  mentions      String[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  reactions CommentReaction[]
  reports   CommentReport[]

  @@index([profileId, createdAt])
  @@index([authorId])
  @@index([parentId])
  @@index([isPinned])
  @@map("profile_comments")
}

model CommentReaction {
  id        String         @id @default(cuid())
  commentId String
  comment   ProfileComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime       @default(now())

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_reactions")
}

model CommentReport {
  id          String              @id @default(cuid())
  commentId   String
  comment     ProfileComment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporterId  String
  reason      CommentReportReason
  description String?
  status      CommentReportStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime            @default(now())

  @@unique([commentId, reporterId])
  @@index([commentId])
  @@index([status])
  @@map("comment_reports")
}

enum ProductType {
  PRIVILEGE
  KEY
  SUBSCRIPTION
  BADGE
  BATTLE_PASS
  BATTLE_PASS_BOOSTER
  UNMUTE
  UNBAN
  CURRENCY
  DECORATION
  BUNDLE
}

enum ProductDuration {
  FOREVER
  MONTHS_3
  MONTH_1
  WEEK_1
  SEASON
  ONE_TIME
}

enum CurrencyType {
  RUBIES
  COINS
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  description   String?
  icon          String?
  image         String?
  order         Int        @default(0)
  isActive      Boolean    @default(true)
  parentId      String?
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id])
  subcategories Category[] @relation("SubCategories")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  description     String?
  fullDescription String?
  type            ProductType
  image           String?
  images          String[]
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id])
  positionId      String?
  position        Position?        @relation(fields: [positionId], references: [id])
  isGiftable      Boolean          @default(true)
  isSelfOnly      Boolean          @default(false)
  isUnique        Boolean          @default(false)
  isSeasonalOnly  Boolean          @default(false)
  maxPerPurchase  Int?
  currencyType    CurrencyType?
  currencyAmount  Int?
  isActive        Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  isNew           Boolean          @default(false)
  isPopular       Boolean          @default(false)
  order           Int              @default(0)
  gameCommands    String[]
  server          String?
  variants        ProductVariant[]
  bundleItems     BundleItem[]     @relation("BundleProduct")
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  bulkDiscounts   BulkDiscount[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([type])
  @@index([isActive, isFeatured])
  @@map("products")
}

model ProductVariant {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  duration   ProductDuration
  price      Decimal         @db.Decimal(10, 2)
  oldPrice   Decimal?        @db.Decimal(10, 2)
  isActive   Boolean         @default(true)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, duration])
  @@index([productId])
  @@map("product_variants")
}

model Bundle {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  description   String?
  image         String?
  totalPrice    Decimal      @db.Decimal(10, 2)
  originalPrice Decimal      @db.Decimal(10, 2)
  isActive      Boolean      @default(true)
  isFeatured    Boolean      @default(false)
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         BundleItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([slug])
  @@map("bundles")
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation("BundleProduct", fields: [productId], references: [id])
  variantId String?
  quantity  Int     @default(1)

  @@unique([bundleId, productId, variantId])
  @@map("bundle_items")
}

model BulkDiscount {
  id            String       @id @default(cuid())
  productId     String?
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productType   ProductType?
  minQuantity   Int          @default(0)
  minAmount     Decimal?     @db.Decimal(10, 2)
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([productType])
  @@map("bulk_discounts")
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  promoCodeId String?
  promoCode   PromoCode? @relation(fields: [promoCodeId], references: [id])
  items       CartItem[]
  updatedAt   DateTime   @updatedAt

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id           String          @id @default(cuid())
  cartId       String
  cart         Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  bundleId     String?
  bundle       Bundle?         @relation(fields: [bundleId], references: [id])
  quantity     Int             @default(1)
  giftToUserId String?
  giftMessage  String?         @db.VarChar(500)
  addedAt      DateTime        @default(now())

  @@index([cartId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  isPublic  Boolean        @default(true)
  items     WishlistItem[]
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@map("wishlist_items")
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  guestMinecraftNick String?     @db.VarChar(16)
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(10, 2)
  discountAmount     Decimal     @default(0) @db.Decimal(10, 2)
  promoCodeId        String?
  promoCode          PromoCode?  @relation(fields: [promoCodeId], references: [id])
  total              Decimal     @db.Decimal(10, 2)
  paymentMethod      String?
  paymentId          String?
  paidAt             DateTime?
  cancelledAt        DateTime?
  refundedAt         DateTime?
  cancelReason       String?
  items              OrderItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id])
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id])
  bundleId     String?
  bundle       Bundle?         @relation(fields: [bundleId], references: [id])
  quantity     Int
  unitPrice    Decimal         @db.Decimal(10, 2)
  totalPrice   Decimal         @db.Decimal(10, 2)
  giftToUserId String?
  giftToUser   User?           @relation("GiftedItems", fields: [giftToUserId], references: [id])
  giftMessage  String?         @db.VarChar(500)
  isDelivered  Boolean         @default(false)
  deliveredAt  DateTime?

  @@index([orderId])
  @@map("order_items")
}

model LoyaltyDiscount {
  id              String  @id @default(cuid())
  minPurchases    Int
  discountPercent Decimal @db.Decimal(5, 2)
  name            String
  description     String?
  isActive        Boolean @default(true)

  @@index([minPurchases])
  @@map("loyalty_discounts")
}

enum NotificationType {
  COMMENT_ON_PROFILE
  COMMENT_MENTION
  COMMENT_REPLY
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  GIFT_RECEIVED
  ORDER_STATUS_CHANGED
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation("NotificationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  message    String?
  link       String?
  imageUrl   String?
  fromUserId String?
  fromUser   User?            @relation("NotificationsFrom", fields: [fromUserId], references: [id])
  metadata   Json?
  isRead     Boolean          @default(false)
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model CurrencyRate {
  id        String   @id @default(cuid())
  currency  String   @unique
  rate      Decimal  @db.Decimal(10, 4)
  symbol    String
  flag      String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@map("currency_rates")
}

model Server {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  address     String
  port        Int      @default(25565)
  type        String
  description String?
  iconUrl     String?
  maxPlayers  Int      @default(100)
  version     String?
  motd        String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  statusLogs ServerStatusLog[]

  @@index([slug])
  @@index([isActive, order])
  @@map("servers")
}

model ServerStatusLog {
  id          String   @id @default(cuid())
  serverId    String
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  online      Boolean
  playerCount Int      @default(0)
  maxPlayers  Int      @default(0)
  players     String[]
  version     String?
  motd        String?
  ping        Int?
  timestamp   DateTime @default(now())

  @@index([serverId, timestamp])
  @@map("server_status_logs")
}
