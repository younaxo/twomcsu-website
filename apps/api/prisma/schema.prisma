generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleGroup {
  PLAYER
  HELPER
  MODERATOR
  ADMIN
  OWNER
}

/// Title inside a role group: purely cosmetic, permissions come from roleGroup
model Position {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  displayName     String
  group           RoleGroup
  color           String    @db.VarChar(7)
  backgroundColor String?   @db.VarChar(9)
  icon            String?
  priority        Int       @default(0)
  description     String?
  isVisible       Boolean   @default(true)
  /// Given to new users of the group, one per group
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users User[]

  @@index([slug])
  @@index([group])
  @@index([priority])
  @@map("positions")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique @db.VarChar(16)
  password      String
  roleGroup     RoleGroup @default(PLAYER)
  positionId    String
  minecraftNick String?   @unique @db.VarChar(16)
  avatar        String?
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Uploaded image, wins over bannerPreset when both are set
  banner       String?
  bannerPreset String?
  statusText   String?   @db.VarChar(128)
  bio          String?   @db.VarChar(500)
  country      String?
  city         String?   @db.VarChar(100)
  gender       Gender?
  birthDate    DateTime?
  showBirthDate Boolean  @default(false)

  /// Hides the whole page from everyone but the owner and the staff
  isProfilePrivate Boolean @default(false)
  hideEmail        Boolean @default(true)
  hideCountry      Boolean @default(false)
  hideCity         Boolean @default(false)
  hideBirthDate    Boolean @default(true)
  hideGender       Boolean @default(false)
  hideStatistics   Boolean @default(false)
  hideSocials      Boolean @default(false)
  hideInventory    Boolean @default(false)
  hideServices     Boolean @default(false)
  hideComments     Boolean @default(false)

  position            Position             @relation(fields: [positionId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  promoCodeUsages     PromoCodeUsage[]
  badges              UserBadge[]
  socialLinks         SocialLink[]
  mediaBadges         UserMediaBadge[]
  mediaBadgeRequests  MediaBadgeRequest[]
  statistics          PlayerStatistics?
  awards              UserAward[]
  profileViews        ProfileView[]        @relation("ProfileViewsReceived")
  viewedProfiles      ProfileView[]        @relation("ProfileViewsSent")
  profileReactions    ProfileReaction[]    @relation("ProfileReactionsReceived")
  givenReactions      ProfileReaction[]    @relation("ProfileReactionsSent")
  profileReports      ProfileReport[]      @relation("ProfileReportsReceived")
  sentReports         ProfileReport[]      @relation("ProfileReportsSent")

  @@index([email])
  @@index([username])
  @@index([minecraftNick])
  @@index([positionId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// Single use link from the "forgot password" flow, lives an hour
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SocialPlatform {
  DISCORD
  TELEGRAM
  VK
  YOUTUBE
  TWITCH
  TIKTOK
  STEAM
}

/// Platforms a creator can be verified on, a subset of SocialPlatform
enum MediaGroup {
  YOUTUBE
  TWITCH
  TIKTOK
}

enum UserBadgeType {
  VERIFIED
  SUBSCRIBER_PLUS
  PROJECT_TEAM
  DEVELOPERS_TEAM
}

enum MediaBadgeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProfileReportReason {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  IMPERSONATION
  OTHER
}

enum ProfileReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum DiscountType {
  PERCENT
  FIXED
  BONUS
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  /// null means unlimited
  maxUses       Int?
  usedCount     Int          @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  usages PromoCodeUsage[]

  @@index([code])
  @@index([isActive])
  @@map("promo_codes")
}

model PromoCodeUsage {
  id          String   @id @default(cuid())
  promoCodeId String
  userId      String
  usedAt      DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([promoCodeId, userId])
  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_code_usages")
}

/// Staff granted marks shown next to the nickname
model UserBadge {
  id        String        @id @default(cuid())
  userId    String
  type      UserBadgeType
  grantedBy String?
  grantedAt DateTime      @default(now())
  expiresAt DateTime?
  isActive  Boolean       @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@map("user_badges")
}

/// One handle or url per platform, the platform decides how it is rendered
model SocialLink {
  id        String         @id @default(cuid())
  userId    String
  platform  SocialPlatform
  value     String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@map("social_links")
}

/// Creator badge, appears on the profile once the staff approves the channel
model UserMediaBadge {
  id         String     @id @default(cuid())
  userId     String
  mediaGroup MediaGroup
  channelUrl String
  isApproved Boolean    @default(false)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaGroup])
  @@index([userId])
  @@map("user_media_badges")
}

model MediaBadgeRequest {
  id          String                  @id @default(cuid())
  userId      String
  mediaGroup  MediaGroup
  channelUrl  String
  description String?
  status      MediaBadgeRequestStatus @default(PENDING)
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("media_badge_requests")
}
