generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleGroup {
  PLAYER
  HELPER
  MODERATOR
  ADMIN
  OWNER
}

/// Title inside a role group: purely cosmetic, permissions come from roleGroup
model Position {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  displayName     String
  group           RoleGroup
  color           String    @db.VarChar(7)
  backgroundColor String?   @db.VarChar(9)
  icon            String?
  priority        Int       @default(0)
  description     String?
  isVisible       Boolean   @default(true)
  /// Given to new users of the group, one per group
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  users User[]

  @@index([slug])
  @@index([group])
  @@index([priority])
  @@map("positions")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique @db.VarChar(16)
  password      String
  roleGroup     RoleGroup @default(PLAYER)
  positionId    String
  minecraftNick String?   @unique @db.VarChar(16)
  avatar        String?
  isVerified    Boolean   @default(false)
  isBanned      Boolean   @default(false)
  banReason     String?
  bannedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  position      Position       @relation(fields: [positionId], references: [id])
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([username])
  @@index([minecraftNick])
  @@index([positionId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}
