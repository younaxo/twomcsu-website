<p style="margin:0 0 8px;color:#9ca3af;font-size:13px;">Здравствуйте, {{username}}!</p>
<h1 style="margin:0 0 12px;font-size:22px;color:#fff;">Дайджест уведомлений</h1>
<p style="margin:0 0 20px;color:#e5e7eb;">Новых уведомлений: {{count}}</p>
{{#each items}}
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-bottom:12px;background:rgba(255,255,255,0.04);border-radius:12px;">
  <tr>
    <td style="padding:14px 16px;">
      <div style="font-weight:700;color:#fff;margin-bottom:4px;">{{title}}</div>
      {{#if message}}<div style="color:#d1d5db;font-size:14px;margin-bottom:8px;">{{message}}</div>{{/if}}
      <a href="{{url}}" style="color:#F57C00;text-decoration:none;font-size:13px;">Открыть</a>
    </td>
  </tr>
</table>
{{/each}}
