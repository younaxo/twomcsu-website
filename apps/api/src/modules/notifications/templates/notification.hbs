<p style="margin:0 0 8px;color:#9ca3af;font-size:13px;">Здравствуйте, {{username}}!</p>
<h1 style="margin:0 0 12px;font-size:22px;color:#fff;">{{title}}</h1>
{{#if message}}
<p style="margin:0 0 20px;line-height:1.5;color:#e5e7eb;">{{message}}</p>
{{/if}}
{{#if actionUrl}}
<a href="{{actionUrl}}" style="display:inline-block;padding:12px 18px;background:#F57C00;color:#111;text-decoration:none;border-radius:10px;font-weight:700;">
  {{actionLabel}}
</a>
{{/if}}
